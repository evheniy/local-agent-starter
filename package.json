{
  "name": "local-agent-starter",
  "version": "0.0.0",
  "description": "Local Agent Starter",
  "private": true,
  "type": "module",
  "agents": "./AGENTS.md",
  "packageManager": "yarn@4.17.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*",
    "workspaces/*"
  ],
  "scripts": {
    "storybook": "cross-env STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6006 --disable-telemetry",
    "check": "run-s lint build test",
    "fix": "run-s 'fix:*'",
    "dev": "run-p 'dev:*'",
    "start": "docker compose up -d",
    "stop": "docker compose down",
    "lint": "run-s 'lint:*'",
    "build": "run-s 'build:*'",
    "test": "run-s 'test:*'",
    "fix:prettier": "prettier . --write",
    "fix:eslint": "eslint . --fix",
    "fix:stylelint": "stylelint '**/*.{css,scss}' --fix",
    "dev:api": "sh workspaces/api/bin/start.sh",
    "dev:static": "sh workspaces/static/bin/start.sh",
    "dev:ui": "sh workspaces/ui/bin/start.sh",
    "lint:ts": "tsc",
    "lint:prettier": "prettier . --check",
    "lint:eslint": "eslint .",
    "lint:stylelint": "stylelint '**/*.{css,scss}'",
    "build:api": "sh workspaces/api/bin/build.sh",
    "build:ui": "sh workspaces/ui/bin/build.sh",
    "build:static": "sh workspaces/static/bin/build.sh",
    "build:storybook": "cross-env STORYBOOK_DISABLE_TELEMETRY=1 storybook build --quiet --disable-telemetry",
    "test:jest": "jest",
    "prebuild": "rimraf dist",
    "postinstall": "husky"
  },
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@vyriy/browserslist-config": "^0.9.1",
    "@vyriy/cn": "^0.9.1",
    "@vyriy/env": "^0.9.1",
    "@vyriy/eslint-config": "^0.9.1",
    "@vyriy/handler": "^0.9.1",
    "@vyriy/html": "^0.9.1",
    "@vyriy/jest-config": "^0.9.1",
    "@vyriy/path": "^0.9.1",
    "@vyriy/prettier-config": "^0.9.1",
    "@vyriy/render": "^0.9.1",
    "@vyriy/router": "^0.9.1",
    "@vyriy/server": "^0.9.1",
    "@vyriy/static": "^0.9.1",
    "@vyriy/storybook-config": "^0.9.1",
    "@vyriy/stylelint-config": "^0.9.1",
    "@vyriy/typescript-config": "^0.9.1",
    "@vyriy/webpack-config": "^0.9.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.6.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "npm-run-all2": "^9.0.2",
    "prettier": "^3.9.4",
    "rimraf": "^6.1.3",
    "storybook": "^10.4.6",
    "stylelint": "^17.14.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.2.1"
  }
}
